GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
JUDGE_EXAMPLES=0
# Required shared secret. Set the same value in Streamlit secrets.
API_TOKEN=
APP_ENV=development
DASHBOARD_PASSWORD=
# Explicit local-only opt-out; never enable for a publicly reachable service.
RAGBENCH_ALLOW_INSECURE_LOCAL=false
BACKEND_URL=http://127.0.0.1:8000
DATA_DIR=./data
# Optional durable PostgreSQL. For Neon use a DIRECT URL with sslmode=require.
# With DATABASE_URL set, DATA_DIR contains only disposable local caches.
DATABASE_URL=
# Pacing applies to logical generation and judge calls; SDK retry backoff is separate.
GROQ_REQUEST_INTERVAL=4
# Optional external tracing; leave false to keep LangSmith disabled even if global tracing is configured.
RAGBENCH_LANGSMITH=false
# local, persistent, ephemeral or unknown; this is an operator declaration, not a durability test.
DATA_STORAGE=local

# Optional backend-only metadata tracing. No content-export mode exists.
RAGBENCH_LANGFUSE=false
LANGFUSE_PROJECT_ID=cmuy5n8jc000mad0kjp3qkz0g
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Separate debugger and saved-experiment opt-ins; leave blank by default.
RAGBENCH_DEBUGGER_TRACING=
RAGBENCH_LANGFUSE_EXPERIMENTS=
# Optional explicit remote prompt label; blank uses versioned local fallback.
RAGBENCH_PROMPT_LABEL=
# Resend operational alerts: backend secrets, fixed destination, no user content.
RESEND_API_KEY=
ALERT_FROM=
ALERT_TO=
# Managed login. Authentication records remain in this project's neon_auth schema.
# Backend URL must be the exact production HTTPS origin, without a trailing slash.
NEON_AUTH_URL=
AUTH_GATEWAY_URL=
# Explicit issuer/audience when different from NEON_AUTH_URL; never infer from a JWT.
NEON_AUTH_ISSUER=
NEON_AUTH_AUDIENCE=
# Dashboard only: enable after the hosted identity flow is configured and verified.
ACCOUNT_LOGIN_ENABLED=false
