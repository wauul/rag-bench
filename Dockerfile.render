# syntax=docker/dockerfile:1
FROM ghcr.io/astral-sh/uv:0.12.19@sha256:04d046b13e60d6bcec73cbc5e1cad25d680dea90c8573340950a0ac2d1aef424 AS uv
FROM python:3.14.7-slim-bookworm@sha256:82bc3c539b8813ada9d68c63b40158fa002f7f33de9bf3312a3dfdc0620dff56 AS models
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /app
ENV UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never HF_HUB_DISABLE_TELEMETRY=1
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv uv sync --locked --no-dev --extra models
COPY backend/__init__.py backend/models.py backend/onnx_inference.py backend/
COPY scripts/prepare_onnx.py scripts/prepare_onnx.py
RUN --mount=type=cache,target=/root/.cache/huggingface .venv/bin/python -m scripts.prepare_onnx
FROM python:3.14.7-slim-bookworm@sha256:82bc3c539b8813ada9d68c63b40158fa002f7f33de9bf3312a3dfdc0620dff56 AS deps
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv uv sync --locked --no-dev --extra backend --extra compact

FROM python:3.14.7-slim-bookworm@sha256:82bc3c539b8813ada9d68c63b40158fa002f7f33de9bf3312a3dfdc0620dff56
WORKDIR /app
ARG APP_REVISION=local
ENV APP_REVISION=$APP_REVISION PATH=/app/.venv/bin:$PATH PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 HOME=/home/app \
    TOKENIZERS_PARALLELISM=false OMP_NUM_THREADS=1 HF_HUB_DISABLE_TELEMETRY=1 \
    RAGAS_DO_NOT_TRACK=true DATA_DIR=/app/data HF_HOME=/app/cache/huggingface INFERENCE_BACKEND=onnx ONNX_MODEL_DIR=/app/models MALLOC_ARENA_MAX=2
RUN apt-get update && apt-get install -y --no-install-recommends git libpcre2-8-0 perl-base \
    && rm -rf /var/lib/apt/lists/* \
    && /usr/local/bin/python -m pip uninstall --yes pip setuptools wheel \
    && groupadd --gid 10001 app && useradd --uid 10001 --gid app --create-home app \
    && mkdir /app/data /app/cache && chown -R app:app /app/data /app/cache
COPY --from=deps /app/.venv /app/.venv
COPY --from=models /app/data/onnx /app/models
COPY backend backend
COPY scripts scripts
COPY sample_data sample_data
USER 10001:10001
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s CMD python -c "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:'+os.getenv('PORT','8000')+'/health',timeout=4)"
CMD ["python", "-m", "scripts.serve"]
